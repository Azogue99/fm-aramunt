rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Helpers

    function signedIn() {
      return request.auth != null;
    }

    function userRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRoles() is list
        && role in userRoles();
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function tournamentManagerRole(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.managerRole;
    }

    function managesTournament(tournamentId) {
      return isSuperAdmin()
        || (exists(/databases/$(database)/documents/tournaments/$(tournamentId))
            && hasRole(tournamentManagerRole(tournamentId)));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(field) {
      return !(field in changedKeys());
    }

    // ---------------------------------------------------------------- Usuaris

    match /users/{userId} {
      // Cal poder llegir els perfils per resoldre rols i mostrar el panell d'usuaris.
      allow read: if signedIn();

      // Un usuari nou només es pot crear a si mateix: o sense cap rol, o
      // exactament amb els que el superadmin li hagi reservat per email.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.roles is list
        && (
          request.resource.data.roles.size() == 0
          || (
            request.auth.token.email != null
            && exists(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower()))
            && request.resource.data.roles ==
               get(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())).data.roles
          )
        );

      // Només el superadmin reparteix rols. Un usuari no es pot autoascendir.
      allow update, delete: if isSuperAdmin();
    }

    match /role_invites/{email} {
      // Cadascú pot comprovar la seva pròpia invitació (cal per al primer login).
      allow get: if isSuperAdmin()
        || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow list, write: if isSuperAdmin();
    }

    // ------------------------------------------------------------- Contingut

    match /web_content/{document} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------------------------------------------------------------- Tornejos

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if managesTournament(tournamentId);
    }

    // ------------------------------------------------------------------ Equips

    match /teams/{teamId} {
      allow read: if true;

      // Qui crea l'equip n'és el capità i l'únic membre. El `status` neix
      // sempre a 'pending': ningú es pot autoaprovar. Abans no es validava cap
      // camp i qualsevol usuari podia crear-se un equip aprovat amb punts.
      allow create: if signedIn()
        && request.resource.data.captainUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId));

      // 1) L'administrador del torneig pot fer qualsevol canvi.
      // 2) El capità gestiona el seu equip, però no l'estat ni de qui és.
      // 3) Qualsevol altre usuari només es pot afegir a si mateix per l'enllaç.
      allow update: if managesTournament(resource.data.tournamentId)
        || isCaptainEdit()
        || isSelfJoin();

      allow delete: if managesTournament(resource.data.tournamentId)
        || request.auth.uid == resource.data.captainUid;

      function isCaptainEdit() {
        return signedIn()
          && request.auth.uid == resource.data.captainUid
          && unchanged('status')
          && unchanged('tournamentId')
          && unchanged('captainUid')
          && unchanged('createdBy');
      }

      function isSelfJoin() {
        return signedIn()
          && resource.data.inviteEnabled == true
          && changedKeys().hasOnly(['memberUids', 'members'])
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <=
             get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.maxPlayers;
      }
    }

    // ----------------------------------------------------------------- Partits

    match /matches/{matchId} {
      allow read: if true;
      allow create: if managesTournament(request.resource.data.tournamentId);
      allow update, delete: if managesTournament(resource.data.tournamentId);
    }

    // ------------------------------------------------------------------- Barra

    match /bar_products/{productId} {
      allow read: if isSuperAdmin() || hasRole('barista');
      allow write: if isSuperAdmin();
    }
  }
}
